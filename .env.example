# Copy to $HOME\poc-secrets\poc-02.env (outside the repo) and fill in locally.
# Never commit real values. scripts\load-secrets.ps1 loads these into TF_VAR_* for one PowerShell window.

# AWS (IAM Identity Center profiles; no static keys)
AWS_PROFILE=poc02-ro
AWS_REGION=eu-west-1

# Datadog (EU site)
DD_SITE=datadoghq.eu

# Managed rotation admin credentials (service account)
DD_ADMIN_API_KEY=
DD_ADMIN_API_KEY_ID=
DD_ADMIN_APP_KEY=
DD_ADMIN_APP_KEY_ID=
DD_SERVICE_ACCOUNT_ID=

# The API key the Agents use (the one that rotates)
DD_CONSUMER_API_KEY=
DD_CONSUMER_API_KEY_ID=

# Least-privilege application keys
# api_keys_read only (safe-to-rotate check)
DD_KEYCHECK_APP_KEY=
# monitors_read and monitors_write only (Terraform Datadog provider)
DD_MONITORS_APP_KEY=

# Optional, for census.py --datadog-status (api_keys_read)
DD_API_KEY=
DD_APP_KEY=
